{
  "manifest_version": 3,

  "name": "Chrome Joule V2",
  "description": "Unofficial Bluetooth controller for a ChefSteps Joule",
  "version": "1.1.0",

  "action": {
    "default_icon": "icon.png"
  },

  "background": {
    "service_worker": "js/background.js"
  },

  "permissions": [
    "notifications"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
