{
  "manifest_version": 3,

  "name": "Chrome Joule V2",
  "description": "Unofficial Bluetooth controller for a ChefSteps Joule",
  "version": "1.1.2",

  "action": {
    "default_icon": {
      "16": "icon-16.png",
      "19": "icon-19.png",
      "32": "icon-32.png",
      "38": "icon-38.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png",
    "192": "icon-192.png",
    "512": "icon-512.png"
  },

  "background": {
    "service_worker": "js/background.js"
  },

  "permissions": [
    "alarms",
    "notifications"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
